{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "detector.trigger",
  "type": "object",
  "required": ["confidence", "category", "bbox", "frame_timestamp", "model_version"],
  "properties": {
    "confidence":       { "type": "number",  "minimum": 0.0, "maximum": 1.0 },
    "category":         { "type": "string",  "enum": ["animal", "person", "vehicle"] },
    "bbox":             { "type": "array",   "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "frame_timestamp":  { "type": "string",  "description": "ISO-8601 timestamp of the source frame" },
    "model_version":    { "type": "string" },
    "class_id":         { "type": "integer" },
    "label":            { "type": "string" }
  },
  "additionalProperties": true
}
